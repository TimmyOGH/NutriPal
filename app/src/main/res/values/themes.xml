<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NutriPal" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Set global font -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>

        <!-- Set primary & secondary color -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/black</item>

        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/black</item>

        <!-- cursor & focus highlight -->
        <item name="colorControlActivated">@color/black</item>

    </style>

    <style name="ShapeAppearance.App.FAB.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>